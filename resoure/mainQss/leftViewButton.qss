QToolButton {
    background-color: #404040; /* 正常状态背景颜色 */
    border: none; /* 移除按钮边框 */
    font-family: '宋体'; /* 设置字体 */
    font-size: 14px;     /* 设置字体大小 */
    padding-bottom: 1px;
    color: white;        /* 设置字体颜色 */
}

QToolButton:hover {
    background-color: blue; /* 鼠标悬停时背景颜色 */
}

QToolButton:pressed {
    background-color: darkblue; /* 按钮按下时背景颜色 */
}

QToolButton:checked {
    background-color: #4a90e2; /* 按钮选中时背景颜色 */

}