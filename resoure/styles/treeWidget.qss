/* =========================================
   QTreeWidget Fluent 风格
   ========================================= */

/* 整体背景 */
QTreeWidget {
    background-color: #E9F2FB;
    border: none;
    outline: none;
    font-size: 18px;
    color: #222;
}

/* 节点（普通状态） */
QTreeWidget::item {
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    margin: 2px 6px;
}

/* 鼠标悬停 */
QTreeWidget::item:hover {
    background-color: #e5f1fb;
    color: #000000;
}

/* 选中项 */
QTreeWidget::item:selected {
    background-color: #0078d7;
    color: white;
}

/* 禁用状态 */
QTreeWidget::item:disabled {
    color: #aaaaaa;
}

/* 去掉 focus 边框虚线 */
QTreeWidget::item:focus {
    outline: none;
}






