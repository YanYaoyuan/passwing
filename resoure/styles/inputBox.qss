/* =========================================
   QLineEdit Fluent 风格（Qt5 兼容版）
   ========================================= */

QLineEdit {
    border: 4px solid #d0d0d0;
    border-radius: 30px;
    background-color: #fafafa;
    padding: 6px 10px;
    font-size: 20px;
    color: #222;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
}

/* 鼠标悬停：略微提亮背景并高亮边框 */
QLineEdit:hover {
    border: 1px solid #0078d7;
    background-color: #ffffff;
}

/* 获取焦点：高亮边框 */
QLineEdit:focus {
    border: 2px solid #0078d7;
    background-color: #ffffff;
    padding: 5px 9px;   /* ⚡ 边框加粗后缩一点内边距防止跳动 */
}

/* 禁用状态 */
QLineEdit:disabled {
    background-color: #f2f2f2;
    border: 1px solid #cccccc;
    color: #999999;
}

/* 占位文字颜色（Qt5 不支持 placeholderText 属性） */
QLineEdit[echoMode="0"]:!focus {
    color: #666666;
}

/* 选中文本 */
QLineEdit::selection {
    background-color: #0078d7;
    color: white;
}


