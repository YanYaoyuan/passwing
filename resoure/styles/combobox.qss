/* ===============================
   🌈 淡蓝主题 QComboBox / QSpinBox / QDoubleSpinBox
   =============================== */

/* ===== 基础外观统一 ===== */
QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #f8fbff;          /* 主体背景，略浅于淡蓝 */
    border: 1px solid #a8c8e6;
    border-radius: 6px;
    padding: 3px 6px;
    color: #003366;
    font: 10pt "Microsoft YaHei";
}

/* ===== 悬停效果 ===== */
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #66a3ff;
    background-color: #ffffff;
}

/* ===== 聚焦高亮 ===== */
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #3399ff;
    background-color: #ffffff;
}

/* ===== 禁用状态 ===== */
QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #e0ebf5;
    border: 1px solid #b0cde0;
    color: #7a96b2;
}

/* ===============================
   ⬇️ QComboBox 专属样式
   =============================== */
QComboBox {
    min-height: 26px;
}

/* 箭头区域（加宽以显示更大箭头） */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;                         /* 🚀 加宽 */
    border-left: 1px solid #a8c8e6;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #e0f0ff;
}

/* 箭头图标（与 SpinBox 统一） */
QComboBox::down-arrow {
    image: url(:/icons/widget/arrow-down.svg);
    width: 20px;
    height: 20px;
    margin-right: 4px;
    qproperty-alignment: AlignCenter;
}

/* 下拉列表 */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #99c2ff;
    selection-background-color: #cce5ff;
    selection-color: #003366;
    outline: none;
}

