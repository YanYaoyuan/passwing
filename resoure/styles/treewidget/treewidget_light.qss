/* treewidget_light.qss */
QTreeWidget {
    background: #E3F2FD;
    color: #1C1C1C;
    border: none;
    font-size: 18px;
}
/* item 格式 + 去掉虚线框 */
QTreeWidget::item {
    height: 28px;
    padding: 6px;
    font-size: 18px;
    outline: none;
}

QHeaderView::section {
    background: #C7DCF3;
    color: #0F1F33;
    border: 1px solid #9BBAD6;
    padding: 4px;
    font-size: 18px;
}
