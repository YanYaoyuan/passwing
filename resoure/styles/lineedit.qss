/* ===============================
   🌈 QLineEdit - 淡蓝圆角风格
   =============================== */

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #a8c8e6;
    border-radius: 6px;
    padding: 4px 6px;
    color: #003366;
    font: 10pt "Microsoft YaHei";
}

/* 悬停时高亮边框 */
QLineEdit:hover {
    border: 1px solid #66a3ff;
    background-color: #f8fbff;
}

/* 聚焦时蓝色光晕 */
QLineEdit:focus {
    border: 1px solid #3399ff;
    background-color: #ffffff;
}

/* 禁用状态 */
QLineEdit:disabled {
    background-color: #e0ebf5;
    border: 1px solid #b0cde0;
    color: #7a96b2;
}