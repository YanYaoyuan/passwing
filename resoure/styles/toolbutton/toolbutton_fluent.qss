QToolButton#toolButton {
    background-color: #3C4352;
    border: 1px solid #3C4352;
    border-radius: 6px;
    color: #E8ECF1;
    font-size: 15px;
    font-weight: 500;
    padding: 4px 8px;
    margin: 2px;
    min-width: 80px;
    outline: none;
}

QToolButton#toolButton:hover {
    background-color: #505865;
    border: 1px solid #5A6572;
    color: #FFFFFF;
}

QToolButton#toolButton:pressed {
    background-color: #434B58;
    border: 1px solid #3C4352;
    color: #FFFFFF;
}

QToolButton#toolButton:checked {
    background-color: #5A6572;
    border: 1px solid #3C4352;
    color: #FFFFFF;
    font-weight: 600;
}

QToolButton#toolButton:disabled {
    background-color: #2F3542;
    border: 1px solid #3C3C44;
    color: #888888;
}

QToolButton#toolButton::menu-indicator {
    image: none;
}

