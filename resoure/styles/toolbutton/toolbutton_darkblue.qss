QToolButton#toolButton {
    background-color: #2C4A6A;
    border: 1px solid #294E75;
    border-radius: 6px;
    color: #E0E8F8;
    font-size: 15px;
    font-weight: 500;
    padding: 4px 8px;
    margin: 2px;
    min-width: 80px;
    outline: none;
}

QToolButton#toolButton:hover {
    background-color: #3A5C83;
    border: 1px solid #4A6EB1;
    color: #FFFFFF;
}

QToolButton#toolButton:pressed {
    background-color: #34567A;
    border: 1px solid #2C4A6A;
    color: #FFFFFF;
}

QToolButton#toolButton:checked {
    background-color: #4A6EB1;
    border: 1px solid #356FB5;
    color: #FFFFFF;
    font-weight: 600;
}

QToolButton#toolButton:disabled {
    background-color: #223455;
    border: 1px solid #2C3A50;
    color: #777777;
}

QToolButton#toolButton::menu-indicator {
    image: none;
}
